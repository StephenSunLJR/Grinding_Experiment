<?xml version="1.0"?>
<launch>
  <arg name="robot_ip" default="172.16.0.2"/>
  <arg name="load_gripper" default="false"/>
  <arg name="arm_id" default="panda"/>

  <include file="$(find franka_control)/launch/franka_control.launch">
    <arg name="robot_ip" value="$(arg robot_ip)"/>
    <arg name="load_gripper" value="$(arg load_gripper)"/>
    <arg name="arm_id" value="$(arg arm_id)"/>
  </include>

  <rosparam command="load"
            file="$(find variable_stiffness_controllers)/config/pure_joint_position_hold.yaml"/>

  <!-- Load only. Starting captures the current q and commands it unchanged. -->
  <node name="pure_joint_position_hold_spawner"
        pkg="controller_manager"
        type="spawner"
        output="screen"
        args="--stopped pure_joint_position_hold"/>
</launch>
