<?xml version="1.0"?>
<launch>
  <arg name="arm_id"      default="panda" doc="机器人名称" />
  
  <arg name="controller"  default="mujoco_icvs_energy_controller" doc="要启动的控制器名称" />
  
  <arg name="rviz"        default="true" doc="是否启动 RViz 观察可视化" />
  <arg name="interactive_marker" default="$(eval arg('controller') == 'cartesian_impedance_example_controller')" />

  <param name="robot_description" command="$(find xacro)/xacro $(find franka_description)/robots/panda/panda.urdf.xacro hand:=false" />

  <rosparam command="load" file="$(find franka_mujoco)/config/test_controllers.yaml" />
  <rosparam file="$(find franka_example_controllers)/config/franka_example_controllers.yaml" subst_value="true" />
  <rosparam file="$(find variable_stiffness_controllers)/config/variable_stiffness_energy.yaml" subst_value="true" />
  <rosparam file="$(find variable_stiffness_controllers)/config/interactive_control.yaml" subst_value="true" />
  <rosparam file="$(find variable_stiffness_controllers)/config/mujoco_icvs_energy.yaml" subst_value="true"/>
  <node name="franka_mujoco_node" pkg="franka_mujoco" type="franka_mujoco_node" output="screen" />

  <node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen"
        args="joint_state_controller $(arg controller)" />

  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" output="screen"/>

  <node name="interactive_marker" pkg="franka_example_controllers" type="interactive_marker.py"
        if="$(arg interactive_marker)">
    <param name="link_name" value="$(arg arm_id)_link0" />
  </node>

  <node pkg="rviz" type="rviz" output="screen" name="rviz"
        args="-d $(find franka_example_controllers)/launch/rviz/franka_description_with_marker.rviz"
        if="$(arg rviz)"/>

</launch>